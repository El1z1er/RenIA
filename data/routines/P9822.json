{
    "id": "P9822",
    "name": "Angled web or pocket",
    "description": "Measure an angled web or pocket using two vectored measuring moves along the XY axes.",

    "options": [
        {
            "name": "Pocket",
            "description": "Measure an internal pocket. Omitting the Z input automatically selects the pocket cycle.",

            "requirements": [
                {
                    "rule": "all",
                    "parameters": [
                        {
                            "parameter": "A",
                            "attribute": "measurement_angle",
                            "type": "float",
                            "description": "Angle of the surface measured from the positive X-axis."
                        },
                        {
                            "parameter": "D",
                            "attribute": "feature_size",
                            "type": "float",
                            "minimum": 0,
                            "description": "Nominal size of the pocket."
                        }
                    ]
                }
            ],

            "optional_parameters": [
                {
                    "parameter": "E",
                    "attribute": "experience_value",
                    "type": "integer",
                    "description": "Tool offset experience value."
                },
                {
                    "parameter": "F",
                    "attribute": "feedback_percentage",
                    "type": "float",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Feedback percentage used when updating a tool offset."
                },
                {
                    "parameter": "H",
                    "attribute": "tolerance",
                    "type": "float",
                    "minimum": 0,
                    "description": "Nominal tolerance of the measured feature."
                },
                {
                    "parameter": "M",
                    "attribute": "true_position_tolerance",
                    "type": "float",
                    "minimum": 0,
                    "description": "True position tolerance."
                },
                {
                    "parameter": "Q",
                    "attribute": "probe_overtravel",
                    "type": "float",
                    "minimum": 0,
                    "description": "Probe overtravel distance."
                },
                {
                    "parameter": "R",
                    "attribute": "radial_clearance",
                    "type": "float",
                    "description": "Radial clearance used to pre-position before each measuring move inside the pocket."
                },
                {
                    "parameter": "S",
                    "attribute": "work_offset",
                    "type": "integer",
                    "allowed_ranges": [
                        {
                            "minimum": 0,
                            "maximum": 6
                        },
                        {
                            "minimum": 53,
                            "maximum": 59
                        },
                        {
                            "minimum": 101,
                            "maximum": 400
                        }
                    ],
                    "description": "Work offset to update."
                },
                {
                    "parameter": "T",
                    "attribute": "tool_offset",
                    "type": "integer",
                    "description": "Tool offset to update."
                },
                {
                    "parameter": "U",
                    "attribute": "upper_tolerance_limit",
                    "type": "float",
                    "description": "Upper tolerance limit."
                },
                {
                    "parameter": "V",
                    "attribute": "null_band",
                    "type": "float",
                    "default": 0,
                    "description": "Tolerance zone where no tool offset correction occurs."
                },
                {
                    "parameter": "W",
                    "attribute": "print_output",
                    "type": "float",
                    "allowed_values": [
                        1,
                        2,
                        1.1
                    ],
                    "description": "Print the output data."
                }
            ],

            "match": [
                {
                    "action": "measure",
                    "target": "angled_pocket"
                },
                {
                    "action": "update",
                    "target": "angled_pocket"
                }
            ]
        },

        {
            "name": "Web",
            "description": "Measure an external web. Supplying the Z input selects the web cycle.",

            "requirements": [
                {
                    "rule": "all",
                    "parameters": [
                        {
                            "parameter": "A",
                            "attribute": "measurement_angle",
                            "type": "float",
                            "description": "Angle of the surface measured from the positive X-axis."
                        },
                        {
                            "parameter": "D",
                            "attribute": "feature_size",
                            "type": "float",
                            "minimum": 0,
                            "description": "Nominal size of the web."
                        },
                        {
                            "parameter": "Z",
                            "attribute": "measurement_height",
                            "type": "float",
                            "description": "Absolute Z-axis position. Presence of this parameter selects the web cycle."
                        }
                    ]
                }
            ],

            "optional_parameters": [
                {
                    "parameter": "E",
                    "attribute": "experience_value",
                    "type": "integer",
                    "description": "Tool offset experience value."
                },
                {
                    "parameter": "F",
                    "attribute": "feedback_percentage",
                    "type": "float",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Feedback percentage used when updating a tool offset."
                },
                {
                    "parameter": "H",
                    "attribute": "tolerance",
                    "type": "float",
                    "minimum": 0,
                    "description": "Nominal tolerance of the measured feature."
                },
                {
                    "parameter": "M",
                    "attribute": "true_position_tolerance",
                    "type": "float",
                    "minimum": 0,
                    "description": "True position tolerance."
                },
                {
                    "parameter": "Q",
                    "attribute": "probe_overtravel",
                    "type": "float",
                    "minimum": 0,
                    "description": "Probe overtravel distance."
                },
                {
                    "parameter": "R",
                    "attribute": "radial_clearance",
                    "type": "float",
                    "description": "Radial clearance used to pre-position before each measuring move."
                },
                {
                    "parameter": "S",
                    "attribute": "work_offset",
                    "type": "integer",
                    "allowed_ranges": [
                        {
                            "minimum": 0,
                            "maximum": 6
                        },
                        {
                            "minimum": 53,
                            "maximum": 59
                        },
                        {
                            "minimum": 101,
                            "maximum": 400
                        }
                    ],
                    "description": "Work offset to update."
                },
                {
                    "parameter": "T",
                    "attribute": "tool_offset",
                    "type": "integer",
                    "description": "Tool offset to update."
                },
                {
                    "parameter": "U",
                    "attribute": "upper_tolerance_limit",
                    "type": "float",
                    "description": "Upper tolerance limit."
                },
                {
                    "parameter": "V",
                    "attribute": "null_band",
                    "type": "float",
                    "default": 0,
                    "description": "Tolerance zone where no tool offset correction occurs."
                },
                {
                    "parameter": "W",
                    "attribute": "print_output",
                    "type": "float",
                    "allowed_values": [
                        1,
                        2,
                        1.1
                    ],
                    "description": "Print the output data."
                }
            ],

            "match": [
                {
                    "action": "measure",
                    "target": "angled_web"
                },
                {
                    "action": "update",
                    "target": "angled_web"
                }
            ]
        }
    ]
}