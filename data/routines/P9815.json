{
    "id": "P9815",
    "name": "Internal corner",
    "description": "Finds the position of an internal corner. The cycle can determine the true corner intersection even when the corner angle is not 90°.",
    "requirements": [
        {
            "rule": "all",
            "parameters": [
                {
                    "parameter": "X",
                    "attribute": "x_position",
                    "type": "float",
                    "description": "Nominal X position of the corner."
                },
                {
                    "parameter": "Y",
                    "attribute": "y_position",
                    "type": "float",
                    "description": "Nominal Y position of the corner."
                }
            ]
        }
    ],
    "optional_parameters": [
        {
            "parameter": "B",
            "attribute": "angle_tolerance",
            "type": "float",
            "minimum": 0,
            "description": "Angular tolerance applied to both X and Y surfaces."
        },
        {
            "parameter": "D",
            "attribute": "x_first_measure_distance",
            "type": "float",
            "default": 0,
            "description": "Distance from the corner to the first probing position in the X axis."
        },
        {
            "parameter": "E",
            "attribute": "y_first_measure_distance",
            "type": "float",
            "default": 0,
            "description": "Distance from the corner to the first probing position in the Y axis."
        },
        {
            "parameter": "I",
            "attribute": "x_second_probe_increment",
            "type": "float",
            "description": "Incremental distance to the second probing position along the X axis."
        },
        {
            "parameter": "J",
            "attribute": "y_second_probe_increment",
            "type": "float",
            "description": "Incremental distance to the second probing position along the Y axis."
        },
        {
            "parameter": "M",
            "attribute": "true_position_tolerance",
            "type": "float",
            "minimum": 0,
            "description": "True position tolerance of the measured feature."
        },
        {
            "parameter": "Q",
            "attribute": "probe_overtravel",
            "type": "float",
            "minimum": 0,
            "description": "Probe overtravel distance used while searching for the surfaces."
        },
        {
            "parameter": "S",
            "attribute": "work_offset",
            "type": "integer",
            "allowed_ranges": [
                {
                    "minimum": 0,
                    "maximum": 6
                },
                {
                    "minimum": 53,
                    "maximum": 59
                },
                {
                    "minimum": 101,
                    "maximum": 400
                }
            ],
            "description": "Work offset to update with the measured error."
        },
        {
            "parameter": "U",
            "attribute": "upper_tolerance_limit",
            "type": "float",
            "description": "Maximum permitted error before cancelling the offset update and raising an alarm."
        },
        {
            "parameter": "W",
            "attribute": "print_output",
            "type": "float",
            "allowed_values": [
                1,
                2,
                1.1
            ],
            "description": "Print or report the measurement result."
        },
        {
            "parameter": "Z",
            "attribute": "measurement_height",
            "type": "float",
            "description": "Z measuring height used for each probing move."
        }
    ],
    "match": [
        {
            "action": "measure",
            "target": "internal_corner"
        },
        {
            "action": "update",
            "target": "internal_corner"
        }
    ]
}