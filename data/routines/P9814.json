{
    "id": "P9814",
    "name": "Bore or Boss",
    "description": "Bore or boss measurement.",
    "options": [
        {
            "name": "Bore",
            "requirements": [
                {
                    "rule": "all",
                    "parameters": [
                        {
                            "parameter": "D",
                            "attribute": "diameter",
                            "type": "float",
                            "description": "Nominal bore diameter."
                        }
                    ]
                }
            ],
            "match": [
                {
                    "action": "measure",
                    "target": "bore"
                },
                {
                    "action": "update",
                    "target": "bore"
                }
            ]
        },
        {
            "name": "Boss",
            "requirements": [
                {
                    "rule": "all",
                    "parameters": [
                        {
                            "parameter": "D",
                            "attribute": "diameter",
                            "type": "float",
                            "description": "Nominal boss diameter."
                        },
                        {
                            "parameter": "Z",
                            "attribute": "z_surface",
                            "type": "float",
                            "description": "Top surface level of the boss."
                        }
                    ]
                }
            ],
            "match": [
                {
                    "action": "measure",
                    "target": "boss"
                },
                {
                    "action": "update",
                    "target": "boss"
                }
            ]
        }
    ],
    "optional_parameters": [
        {
            "parameter": "E",
            "attribute": "experience_offset",
            "type": "integer",
            "minimum": 0,
            "description": "Tool offset containing the experience value applied to the measured result."
        },
        {
            "parameter": "F",
            "attribute": "feedback_percentage",
            "type": "float",
            "minimum": 0,
            "maximum": 1,
            "default": 1,
            "description": "Feedback percentage applied when updating the tool offset."
        },
        {
            "parameter": "H",
            "attribute": "feature_tolerance",
            "type": "float",
            "minimum": 0,
            "description": "Nominal tolerance of the measured feature size."
        },
        {
            "parameter": "M",
            "attribute": "true_position_tolerance",
            "type": "float",
            "minimum": 0,
            "description": "True position tolerance of the measured feature."
        },
        {
            "parameter": "Q",
            "attribute": "probe_overtravel",
            "type": "float",
            "minimum": 0,
            "description": "Probe overtravel distance used while searching for the feature surface."
        },
        {
            "parameter": "R",
            "attribute": "radial_clearance",
            "type": "float",
            "default": 5,
            "description": "Radial clearance from the nominal feature before the Z-axis approach."
        },
        {
            "parameter": "S",
            "attribute": "work_offset",
            "type": "integer",
            "allowed_ranges": [
                {
                    "minimum": 0,
                    "maximum": 6
                },
                {
                    "minimum": 53,
                    "maximum": 59
                },
                {
                    "minimum": 101,
                    "maximum": 400
                }
            ],
            "description": "Work offset to update with the measured error."
        },
        {
            "parameter": "T",
            "attribute": "tool_offset",
            "type": "integer",
            "minimum": 0,
            "description": "Tool offset to update with the measured error."
        },
        {
            "parameter": "U",
            "attribute": "upper_tolerance_limit",
            "type": "float",
            "minimum": 0,
            "description": "Maximum permitted error before cancelling the offset update and raising an alarm."
        },
        {
            "parameter": "V",
            "attribute": "null_band",
            "type": "float",
            "minimum": 0,
            "default": 0,
            "description": "Tolerance zone where no offset correction is applied."
        },
        {
            "parameter": "W",
            "attribute": "print_output",
            "type": "float",
            "allowed_values": [
                1,
                2,
                1.1
            ],
            "description": "Print or report the measurement result."
        }
    ]
}