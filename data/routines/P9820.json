{
    "id": "P9820",
    "name": "Stock allowance",
    "description": "Measure stock allowance.",

    "options": [
        {
            "name": "X axis",
            "requirements": [
                {
                    "rule": "all",
                    "parameters": [
                        {
                            "parameter": "X",
                            "attribute": "x_position",
                            "type": "float",
                            "description": "Nominal X position where the stock allowance will be measured."
                        }
                    ]
                }
            ],
            "optional_parameters": [
                {
                    "parameter": "J",
                    "attribute": "y_clearance",
                    "type": "float",
                    "description": "Y-axis clearance before the probing move."
                },
                {
                    "parameter": "K",
                    "attribute": "z_clearance",
                    "type": "float",
                    "description": "Z-axis clearance before the probing move."
                },
                {
                    "parameter": "S",
                    "attribute": "work_offset",
                    "type": "integer",
                    "allowed_ranges": [
                        {
                            "minimum": 0,
                            "maximum": 6
                        },
                        {
                            "minimum": 53,
                            "maximum": 59
                        },
                        {
                            "minimum": 101,
                            "maximum": 400
                        }
                    ],
                    "description": "Work offset to update."
                },
                {
                    "parameter": "U",
                    "attribute": "upper_tolerance_limit",
                    "type": "float",
                    "description": "Upper tolerance limit. If exceeded, the tool offset is not updated and the cycle stops with an alarm."
                },
                {
                    "parameter": "Q",
                    "attribute": "probe_overtravel",
                    "type": "float",
                    "description": "Probe overtravel distance. Default for X/Y measurements is 10 mm."
                }
            ],
            "match": [
                {
                    "action": "measure",
                    "target": "stock_allowance"
                }
            ]
        },
        {
            "name": "Y axis",
