{
    "id": "P9818",
    "name": "4th axis measurement",
    "description": "Measures the angular error of a rotary axis by probing two points on a reference surface and calculates the correction required for the rotary axis.",
    "variants": [
        {
            "id": "K1",
            "default": true,
            "description": "Measure a rotary axis parallel to the Y axis.",
            "requirements": [
                {
                    "rule": "all",
                    "parameters": [
                        {
                            "parameter": "Y",
                            "attribute": "measurement_distance",
                            "type": "float",
                            "minimum": 0,
                            "description": "Distance between the two measurement positions along the Y axis."
                        },
                        {
                            "parameter": "Z",
                            "attribute": "surface_position",
                            "type": "float",
                            "description": "Expected Z position of the reference surface."
                        }
                    ]
                }
            ],
            "optional_parameters": [
                {
                    "parameter": "Q",
                    "attribute": "probe_overtravel",
                    "type": "float",
                    "minimum": 0,
                    "description": "Probe overtravel distance."
                },
                {
                    "parameter": "B",
                    "attribute": "angle_tolerance",
                    "type": "float",
                    "minimum": 0,
                    "description": "Half of the total angular tolerance."
                },
                {
                    "parameter": "S",
                    "attribute": "work_offset",
                    "type": "integer",
                    "allowed_ranges": [
                        {
                            "minimum": 0,
                            "maximum": 6
                        },
                        {
                            "minimum": 53,
                            "maximum": 59
                        },
                        {
                            "minimum": 101,
                            "maximum": 400
                        }
                    ],
                    "description": "Work offset to update."
                },
                {
                    "parameter": "W",
                    "attribute": "print_output",
                    "type": "float",
                    "allowed_values": [
                        1,
                        2,
                        1.1
                    ],
                    "description": "Print or report the measurement result."
                }
            ]
        },
        {
