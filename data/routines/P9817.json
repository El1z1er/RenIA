{
    "id": "P9817",
    "name": "Rectangle",
    "description": "Finds the centre position and orientation of a rectangular feature using a 5-point measurement cycle.",
    "options": [
        {
            "name": "External feature",
            "requirements": [
                {
                    "rule": "all",
                    "parameters": [
                        {
                            "parameter": "D",
                            "attribute": "x_size",
                            "type": "float",
                            "description": "Nominal X dimension of the rectangle."
                        },
                        {
                            "parameter": "E",
                            "attribute": "y_size",
                            "type": "float",
                            "description": "Nominal Y dimension of the rectangle."
                        },
                        {
                            "parameter": "Z",
                            "attribute": "measurement_height",
                            "type": "float",
                            "description": "Measurement height for an external rectangle."
                        }
                    ]
                }
            ],
            "match": [
                {
                    "action": "measure",
                    "target": "external_rectangle"
                },
                {
                    "action": "update",
                    "target": "external_rectangle"
                }
            ]
        },
        {
            "name": "Internal feature",
            "requirements": [
                {
                    "rule": "all",
                    "parameters": [
                        {
                            "parameter": "D",
                            "attribute": "x_size",
                            "type": "float",
                            "description": "Nominal X dimension of the rectangle."
                        },
                        {
                            "parameter": "E",
                            "attribute": "y_size",
                            "type": "float",
                            "description": "Nominal Y dimension of the rectangle."
                        }
                    ]
                }
            ],
            "match": [
                {
                    "action": "measure",
                    "target": "internal_rectangle"
                },
                {
                    "action": "update",
                    "target": "internal_rectangle"
                }
            ]
        }
    ],
    "optional_parameters": [
        {
            "parameter": "A",
            "attribute": "measurement_axis",
            "type": "integer",
            "allowed_values": [
                11,
                12,
                13
            ],
            "description": "Measurement orientation."
        },
        {
            "parameter": "B",
            "attribute": "angle_tolerance",
            "type": "float",
            "minimum": 0,
            "description": "Surface angle tolerance."
        },
        {
            "parameter": "H",
            "attribute": "feature_tolerance",
            "type": "float",
            "minimum": 0,
            "description": "Nominal tolerance of the measured feature."
        },
        {
            "parameter": "M",
            "attribute": "true_position_tolerance",
            "type": "float",
            "minimum": 0,
            "description": "True position tolerance."
        },
        {
            "parameter": "Q",
            "attribute": "probe_overtravel",
            "type": "float",
            "minimum": 0,
            "description": "Probe overtravel distance."
        },
        {
            "parameter": "R",
            "attribute": "radial_clearance",
            "type": "float",
            "description": "Radial clearance before Z-axis approach."
        },
        {
            "parameter": "S",
            "attribute": "work_offset",
            "type": "integer",
            "allowed_ranges": [
                {
                    "minimum": 0,
                    "maximum": 6
                },
                {
                    "minimum": 53,
                    "maximum": 59
                },
                {
                    "minimum": 101,
                    "maximum": 400
                }
            ],
            "description": "Work offset to update."
        },
        {
            "parameter": "T",
            "attribute": "tool_offset",
            "type": "integer",
            "description": "Tool offset to update."
        },
        {
            "parameter": "U",
            "attribute": "upper_tolerance_limit",
            "type": "float",
            "description": "Upper tolerance limit."
        },
        {
            "parameter": "V",
            "attribute": "null_band",
            "type": "float",
            "minimum": 0,
            "default": 0,
            "description": "Null band."
        },
        {
            "parameter": "W",
            "attribute": "print_output",
            "type": "float",
            "allowed_values": [
                1,
                2,
                1.1
            ],
            "description": "Print or report the measurement result."
        }
    ]
}